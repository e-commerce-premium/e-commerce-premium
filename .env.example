# Premium E-Commerce Configuration

# Stripe (Périmètre)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-publishable-key-here
STRIPE_SECRET_KEY=your-secret-key-here

# App
APP_NAME="Lumière"
APP_URL=https://lumiere-premium.com

# API Keys (optionnelles)
API_KEY=your-api-key-here

# Email (optionnelles)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
FROM_EMAIL="noreply@lumiere.com"
